{
  "compilerOptions": {
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "pretty": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "importsNotUsedAsValues": "remove",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  }
}
