{
  "compilerOptions": {
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "pretty": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "importsNotUsedAsValues": "remove",
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"]
  }
}
